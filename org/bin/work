#!/usr/bin/env bash
# 업무담당자 한 명을 근무시킨다 — 클로드 코드 표준 방식(--agent)으로.
#
#   bin/work soc-analyst                     대화형 근무
#   bin/work soc-analyst -p "오늘 경보 정리"   요청 한 건 처리(헤드리스)
#
# 환경 변수
#   LAB_MODE=mock|live   (기본 mock)    LAB_FIXTURES=<시나리오.yaml>   MODEL=haiku|sonnet|opus
#   LAB_EVIDENCE_DIR     (기본 evidence/<시각>-<담당자>)
set -euo pipefail
ORG="$(cd "$(dirname "$0")/.." && pwd)"
worker="${1:-}"
if [ -z "$worker" ] || [ ! -f "$ORG/.claude/agents/$worker.md" ]; then
  echo "사용법: bin/work <담당자> [-p \"요청\"]" >&2
  echo "담당자:" >&2; ls "$ORG/.claude/agents" | sed 's/\.md$//; s/^/  /' >&2
  exit 1
fi
shift
export LAB_WORKER="$worker"
export LAB_MODE="${LAB_MODE:-mock}"
export LAB_EVIDENCE_DIR="${LAB_EVIDENCE_DIR:-$ORG/evidence/$(date +%Y%m%d-%H%M%S)-$worker}"
mkdir -p "$LAB_EVIDENCE_DIR"
# 구독 세션만 쓴다(kt66 원칙). API 키 변수가 남아 있으면 클로드 코드는 그것을 먼저 쓴다.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN 2>/dev/null || true
cd "$ORG"
# 처음 보는 폴더의 settings.json 허용 규칙은 '신뢰' 전까지 무시된다. 헤드리스 실행에서도
# 같은 결과가 나오도록 근무에 필요한 최소 허용만 실행 인자로 다시 준다(권한 상한은 랩 서버가 강제).
ALLOW="mcp__lab__*,Skill,Read,Grep,Glob,Edit(/evidence/**),Edit(/tickets/**),Edit(/candidates/**)"
if grep -q "^tools:.*WebSearch" "$ORG/.claude/agents/$worker.md"; then ALLOW="$ALLOW,WebSearch,WebFetch"; fi
exec claude --agent "$worker" \
  --setting-sources project,local \
  --allowedTools "$ALLOW" \
  --mcp-config "$ORG/.mcp.json" --strict-mcp-config \
  ${MODEL:+--model "$MODEL"} "$@"
