{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "mcp__lab__*",
      "Skill",
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Edit(/evidence/**)",
      "Edit(/tickets/**)",
      "Edit(/candidates/**)"
    ],
    "deny": [
      "Bash",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/lab/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_stamp.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__lab__change_prepare|mcp__lab__change_apply",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/change_gate.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/skill_log.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/report_gate.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false
}
